# ============================================================================
# Backend Environment Variables — Cloud SQL Configuration
# ============================================================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control (already in .gitignore)

# ----------------------------------------------------------------------------
# Cloud SQL Connection (US-030 Medication Reconciliation)
# ----------------------------------------------------------------------------
# Cloud SQL Instance Connection Name
CLOUD_SQL_CONNECTION_NAME=smarthandoff:us-central1:smarthandoff

# Database Credentials
DB_USER=postgres
DB_PASSWORD=YOUR_DATABASE_PASSWORD_HERE
DB_NAME=smarthandoff
DB_PORT=5432

# Constructed Database URL (asyncpg for SQLAlchemy async)
# For Cloud SQL Proxy running locally on port 5432:
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}

# For Cloud Run with Unix Socket (Cloud SQL Connector):
# DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@/cloudsql/${CLOUD_SQL_CONNECTION_NAME}/${DB_NAME}

# For Private IP (VPC):
# DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@10.x.x.x:5432/${DB_NAME}

# ----------------------------------------------------------------------------
# GCP Project Configuration
# ----------------------------------------------------------------------------
GCP_PROJECT_ID=smarthandoff
GCP_REGION=us-central1

# Service Account Key (for local development only)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ----------------------------------------------------------------------------
# Vertex AI Configuration (US-030 TASK-003, TASK-004)
# ----------------------------------------------------------------------------
VERTEX_AI_PROJECT=${GCP_PROJECT_ID}
VERTEX_AI_LOCATION=${GCP_REGION}
VERTEX_AI_MODEL=gemini-1.5-pro

# ----------------------------------------------------------------------------
# Secret Manager (US-064 Notification Service)
# ----------------------------------------------------------------------------
# Secrets stored in GCP Secret Manager:
# - DATABASE_PASSWORD → secret://smarthandoff/database-password
# - TWILIO_AUTH_TOKEN → secret://smarthandoff/twilio-auth-token

# ----------------------------------------------------------------------------
# CORS Configuration
# ----------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS requests
# Examples:
# - Local development: http://localhost:4200
# - Cloud Run: https://smarthandoff-frontend-52528248131.us-central1.run.app
# - Production: https://app.smarthandoff.com
CORS_ORIGINS=http://localhost:4200,https://smarthandoff-frontend-52528248131.us-central1.run.app
# - SENDGRID_API_KEY → secret://smarthandoff/sendgrid-api-key

# ----------------------------------------------------------------------------
# FastAPI Configuration
# ----------------------------------------------------------------------------
API_V1_PREFIX=/api/v1
DEBUG=False
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# FHIR Server (US-030 TASK-002)
# ----------------------------------------------------------------------------
FHIR_BASE_URL=https://healthcare.googleapis.com/v1/projects/${GCP_PROJECT_ID}/locations/${GCP_REGION}/datasets/YOUR_DATASET/fhirStores/YOUR_FHIR_STORE/fhir

# ----------------------------------------------------------------------------
# RxNorm API (US-030 TASK-003)
# ----------------------------------------------------------------------------
RXNORM_API_BASE_URL=https://rxnav.nlm.nih.gov/REST

# ----------------------------------------------------------------------------
# JWT / Authentication (US-056, US-057)
# ----------------------------------------------------------------------------
SECRET_KEY=YOUR_SECRET_KEY_HERE_CHANGE_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ----------------------------------------------------------------------------
# Redis / JWT Blocklist (US-059)
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ----------------------------------------------------------------------------
# Pub/Sub (US-064)
# ----------------------------------------------------------------------------
PUBSUB_TOPIC_NOTIFICATION=smarthandoff-notifications
PUBSUB_SUBSCRIPTION_NOTIFICATION=smarthandoff-notifications-sub

# ----------------------------------------------------------------------------
# Twilio (US-064, US-065)
# ----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=secret://smarthandoff/twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=YOUR_TWILIO_VERIFY_SID

# ----------------------------------------------------------------------------
# SendGrid (US-064)
# ----------------------------------------------------------------------------
SENDGRID_API_KEY=secret://smarthandoff/sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@smarthandoff.com
SENDGRID_FROM_NAME=SmartHandoff

# ----------------------------------------------------------------------------
# Alembic (Database Migrations)
# ----------------------------------------------------------------------------
# Alembic reads DATABASE_URL from environment
# Ensure Cloud SQL Proxy is running before migrations

# ----------------------------------------------------------------------------
# Cloud Run (Production)
# ----------------------------------------------------------------------------
# In Cloud Run, these are set via:
# - Secret Manager bindings
# - Environment variables in service YAML
# - Cloud SQL connector (automatic Unix socket)
